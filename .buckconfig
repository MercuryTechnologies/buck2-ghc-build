[cells]
root = .
prelude = prelude
toolchains = toolchains
# NOTE: update [project] ignore below
# toolchains = ghcHEAD-toolchains
nix = nix
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
fbcode_macros = none
buck = none

[external_cells]
prelude = git

[external_cell_prelude]
git_origin = https://github.com/MercuryTechnologies/buck2-prelude.git
# branch: wavewave/metadata-parallelism
commit_hash = 78867039d1e4ef0ceee4dcd03955227f5c9a3a6a

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

[project]
ignore = .git, tmp

[buck2]
materializations = deferred
